// TLL Mall - SHEIN Style User Center Page
// All logic inline to ensure stability

from "./database" import db_query, db_queryOne
from "./router" import router_get, res_html, res_redirect
from "./auth" import auth_currentUser, cookie_getSessionId

fn shein_user_registerRoutes(router) {
    // SHEIN style user center
    router_get(router, "/shein-user", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let user = auth_currentUser(sessionId)
        if (user == null) {
            return res_redirect("/login")
        }

        let userId = user.id

        // Get user stats
        let points = 0
        let userInfo = db_queryOne(req.db, "SELECT points FROM users WHERE id = ?", [userId])
        if (userInfo != null) { points = userInfo.points }

        let couponCount = 0
        let couponResult = db_queryOne(req.db, "SELECT COUNT(*) as total FROM user_coupons WHERE user_id = ? AND status = 'unused'", [userId])
        if (couponResult != null) { couponCount = couponResult.total }

        let favCount = 0
        let favResult = db_queryOne(req.db, "SELECT COUNT(*) as total FROM user_collections WHERE user_id = ?", [userId])
        if (favResult != null) { favCount = favResult.total }

        let orderPending = 0
        let orderPendingResult = db_queryOne(req.db, "SELECT COUNT(*) as total FROM orders WHERE user_id = ? AND status = 'pending'", [userId])
        if (orderPendingResult != null) { orderPending = orderPendingResult.total }

        let orderShipped = 0
        let orderShippedResult = db_queryOne(req.db, "SELECT COUNT(*) as total FROM orders WHERE user_id = ? AND status = 'shipped'", [userId])
        if (orderShippedResult != null) { orderShipped = orderShippedResult.total }

        let orderCompleted = 0
        let orderCompletedResult = db_queryOne(req.db, "SELECT COUNT(*) as total FROM orders WHERE user_id = ? AND status = 'completed'", [userId])
        if (orderCompletedResult != null) { orderCompleted = orderCompletedResult.total }

        let userName = user.username
        if (userName == null || userName == "") { userName = "TLL用户" + convert.toString(userId) }

        let avatarText = userName[0]
        if (avatarText == null) { avatarText = "U" }

        let body =
            // User Info Header
            "<div style='background:linear-gradient(135deg,#000,#333);color:#fff;padding:20px 16px 30px'>" +
            "<div style='display:flex;align-items:center;gap:14px'>" +
            "<div style='width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#ff4400,#ff6b6b);display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:bold'>" + avatarText + "</div>" +
            "<div style='flex:1'>" +
            "<div style='font-size:18px;font-weight:700;margin-bottom:4px'>" + userName + "</div>" +
            "<div style='display:flex;align-items:center;gap:8px'>" +
            "<span style='background:linear-gradient(135deg,#ffd700,#ffaa00);color:#000;font-size:10px;padding:2px 8px;border-radius:10px;font-weight:700'>👑 普通会员</span>" +
            "<span style='font-size:12px;opacity:0.7'>ID: " + convert.toString(userId) + "</span>" +
            "</div>" +
            "</div>" +
            "<a href='/user-center' style='color:#fff;opacity:0.7;font-size:20px'>⚙️</a>" +
            "</div>" +
            "</div>" +

            // My Assets
            "<div style='background:#fff;margin:-16px 12px 10px;border-radius:12px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,0.08)'>" +
            "<div style='display:grid;grid-template-columns:1fr 1fr 1fr 1fr;text-align:center'>" +
            "<a href='/points' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:20px;font-weight:800;color:#000'>" + convert.toString(points) + "</div>" +
            "<div style='font-size:11px;color:#999;margin-top:2px'>积分</div>" +
            "</a>" +
            "<a href='/my/coupons' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:20px;font-weight:800;color:#000'>" + convert.toString(couponCount) + "</div>" +
            "<div style='font-size:11px;color:#999;margin-top:2px'>优惠券</div>" +
            "</a>" +
            "<a href='/collections' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:20px;font-weight:800;color:#000'>" + convert.toString(favCount) + "</div>" +
            "<div style='font-size:11px;color:#999;margin-top:2px'>收藏</div>" +
            "</a>" +
            "<a href='#' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:20px;font-weight:800;color:#000'>0</div>" +
            "<div style='font-size:11px;color:#999;margin-top:2px'>足迹</div>" +
            "</a>" +
            "</div>" +
            "</div>" +

            // My Orders
            "<div class='shein-section' style='margin:10px 12px'>" +
            "<div class='shein-section-header'>" +
            "<div class='shein-section-title'>我的订单</div>" +
            "<a href='/orders' class='shein-section-more'>全部订单 ›</a>" +
            "</div>" +
            "<div style='display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr;text-align:center;padding:16px 0'>" +
            "<a href='/orders?status=pending' style='text-decoration:none;color:#333;position:relative'>" +
            "<div style='font-size:24px;margin-bottom:4px'>💰</div>" +
            "<div style='font-size:11px;color:#666'>待付款</div>" +
            (orderPending > 0 ? "<span style='position:absolute;top:0;right:25%;background:#ff4400;color:#fff;font-size:10px;min-width:16px;height:16px;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0 4px;font-weight:600'>" + convert.toString(orderPending) + "</span>" : "") +
            "</a>" +
            "<a href='/orders?status=paid' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:24px;margin-bottom:4px'>📦</div>" +
            "<div style='font-size:11px;color:#666'>待发货</div>" +
            "</a>" +
            "<a href='/orders?status=shipped' style='text-decoration:none;color:#333;position:relative'>" +
            "<div style='font-size:24px;margin-bottom:4px'>🚚</div>" +
            "<div style='font-size:11px;color:#666'>待收货</div>" +
            (orderShipped > 0 ? "<span style='position:absolute;top:0;right:25%;background:#ff4400;color:#fff;font-size:10px;min-width:16px;height:16px;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0 4px;font-weight:600'>" + convert.toString(orderShipped) + "</span>" : "") +
            "</a>" +
            "<a href='/orders?status=completed' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:24px;margin-bottom:4px'>⭐</div>" +
            "<div style='font-size:11px;color:#666'>待评价</div>" +
            "</a>" +
            "<a href='/aftersales' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:24px;margin-bottom:4px'>↩️</div>" +
            "<div style='font-size:11px;color:#666'>退款/售后</div>" +
            "</a>" +
            "</div>" +
            "</div>" +

            // Quick Tools
            "<div class='shein-section' style='margin:10px 12px'>" +
            "<div class='shein-section-header'>" +
            "<div class='shein-section-title'>常用工具</div>" +
            "</div>" +
            "<div style='display:grid;grid-template-columns:1fr 1fr 1fr 1fr;text-align:center;padding:16px 0;gap:16px 0'>" +
            "<a href='/addresses' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:24px;margin-bottom:4px'>📍</div>" +
            "<div style='font-size:11px;color:#666'>地址管理</div>" +
            "</a>" +
            "<a href='/points-mall' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:24px;margin-bottom:4px'>🎁</div>" +
            "<div style='font-size:11px;color:#666'>积分商城</div>" +
            "</a>" +
            "<a href='/member/level' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:24px;margin-bottom:4px'>👑</div>" +
            "<div style='font-size:11px;color:#666'>会员中心</div>" +
            "</a>" +
            "<a href='/realname' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:24px;margin-bottom:4px'>🪪</div>" +
            "<div style='font-size:11px;color:#666'>实名认证</div>" +
            "</a>" +
            "<a href='/seckill' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:24px;margin-bottom:4px'>⚡</div>" +
            "<div style='font-size:11px;color:#666'>限时秒杀</div>" +
            "</a>" +
            "<a href='/groupbuy' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:24px;margin-bottom:4px'>👥</div>" +
            "<div style='font-size:11px;color:#666'>拼团优惠</div>" +
            "</a>" +
            "<a href='/articles' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:24px;margin-bottom:4px'>📰</div>" +
            "<div style='font-size:11px;color:#666'>资讯文章</div>" +
            "</a>" +
            "<a href='#' style='text-decoration:none;color:#333'>" +
            "<div style='font-size:24px;margin-bottom:4px'>💬</div>" +
            "<div style='font-size:11px;color:#666'>联系客服</div>" +
            "</a>" +
            "</div>" +
            "</div>" +

            // Bottom Tab Bar
            "<div class='shein-tabbar'>" +
            "<a href='/shein-home' class='shein-tab-item'>" +
            "<span class='shein-tab-icon'>🏠</span>" +
            "<span class='shein-tab-label'>首页</span>" +
            "</a>" +
            "<a href='/categories' class='shein-tab-item'>" +
            "<span class='shein-tab-icon'>📋</span>" +
            "<span class='shein-tab-label'>分类</span>" +
            "</a>" +
            "<a href='/shein-cart' class='shein-tab-item' style='position:relative'>" +
            "<span class='shein-tab-icon'>🛒</span>" +
            "<span class='shein-tab-label'>购物车</span>" +
            "</a>" +
            "<a href='/shein-user' class='shein-tab-item active'>" +
            "<span class='shein-tab-icon'>👤</span>" +
            "<span class='shein-tab-label'>我的</span>" +
            "</a>" +
            "</div>"

        return res_html("<html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no'><title>我的 - SHEIN Style</title><link rel='stylesheet' href='/static/css/shein-style.css'></head><body style='padding-bottom:60px;background:#f5f5f5'>" + body + "</body></html>")
    })
}

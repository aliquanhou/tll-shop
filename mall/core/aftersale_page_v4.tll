// TLL Mall - After Sales Page - Version 4 (list + detail only)
// All logic inline to ensure stability

from "./database" import db_query, db_queryOne
from "./router" import router_get, res_html, res_redirect
from "./auth" import auth_currentUser, cookie_getSessionId

fn aftersale_registerRoutes(router) {
    // After sale list (售后列表)
    router_get(router, "/aftersales", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let user = auth_currentUser(sessionId)
        if (user == null) {
            return res_redirect("/login")
        }

        let userId = user.id
        let aftersales = db_query(req.db, "SELECT a.*, o.order_no FROM after_sales a LEFT JOIN orders o ON a.order_id = o.id WHERE a.user_id = ? ORDER BY a.id DESC LIMIT 20", [userId])

        let listHtml = ""
        let i = 0
        while (i < arrays.length(aftersales)) {
            let a = aftersales[i]
            let statusText = "待处理"
            let statusColor = "#faad14"
            if (a.status == "approved") { statusText = "已同意"; statusColor = "#52c41a" }
            if (a.status == "rejected") { statusText = "已拒绝"; statusColor = "#ff4400" }
            if (a.status == "completed") { statusText = "已完成"; statusColor = "#1890ff" }

            listHtml = listHtml +
                "<a href='/aftersale/" + convert.toString(a.id) + "' style='display:block;background:#fff;border-radius:8px;padding:16px;margin-bottom:12px;text-decoration:none;color:inherit'>" +
                "<div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:8px'>" +
                "<div style='font-size:16px;font-weight:bold'>售后单号：" + convert.toString(a.id) + "</div>" +
                "<span style='background:" + statusColor + "15;color:" + statusColor + ";padding:4px 12px;border-radius:4px;font-size:13px;font-weight:bold'>" + statusText + "</span>" +
                "</div>" +
                "<div style='font-size:14px;color:#666;margin-bottom:4px'>订单号：" + a.order_no + "</div>" +
                "<div style='font-size:13px;color:#999'>申请时间：" + a.created_at + "</div>" +
                "</a>"
            i = i + 1
        }

        if (arrays.length(aftersales) == 0) {
            listHtml = "<div style='padding:60px;text-align:center;color:#999;background:#fff;border-radius:8px'>暂无售后记录</div>"
        }

        let body =
            "<div style='background:linear-gradient(135deg,#722ed1,#531dab);color:#fff;padding:20px;margin-bottom:16px'>" +
            "<div style='max-width:800px;margin:0 auto'>" +
            "<h1 style='margin:0 0 4px 0;font-size:28px'>售后服务</h1>" +
            "<p style='margin:0;font-size:14px;opacity:0.9'>查看和管理您的售后申请</p>" +
            "</div>" +
            "</div>" +
            "<div style='max-width:800px;margin:0 auto;padding:0 16px'>" +
            listHtml +
            "</div>"

        return res_html("<html><head><meta charset='utf-8'><title>售后服务</title></head><body style='margin:0;background:#f5f5f5;font-family:sans-serif'>" + body + "</body></html>")
    })

    // After sale detail (售后详情)
    router_get(router, "/aftersale/:id", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let user = auth_currentUser(sessionId)
        if (user == null) {
            return res_redirect("/login")
        }

        let aftersaleId = convert.toInt(req.params.id)
        let userId = user.id

        let a = db_queryOne(req.db, "SELECT a.*, o.order_no, o.total_amount, o.address_name, o.address_phone FROM after_sales a LEFT JOIN orders o ON a.order_id = o.id WHERE a.id = ? AND a.user_id = ?", [aftersaleId, userId])
        if (a == null) {
            return res_redirect("/aftersales")
        }

        let orderItems = db_query(req.db, "SELECT oi.*, p.name as product_name FROM order_items oi LEFT JOIN products p ON oi.product_id = p.id WHERE oi.order_id = ?", [a.order_id])

        let statusText = "待处理"
        let statusColor = "#faad14"
        if (a.status == "approved") { statusText = "已同意"; statusColor = "#52c41a" }
        if (a.status == "rejected") { statusText = "已拒绝"; statusColor = "#ff4400" }
        if (a.status == "completed") { statusText = "已完成"; statusColor = "#1890ff" }

        let itemsHtml = ""
        let j = 0
        while (j < arrays.length(orderItems)) {
            let item = orderItems[j]
            itemsHtml = itemsHtml +
                "<div style='display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f0f0f0'>" +
                "<span>" + item.product_name + " x " + convert.toString(item.quantity) + "</span>" +
                "<span style='color:#ff4400;font-weight:bold'>¥" + convert.toString(item.price * item.quantity) + "</span>" +
                "</div>"
            j = j + 1
        }

        let body =
            "<div style='max-width:800px;margin:0 auto;padding:16px'>" +
            "<a href='/aftersales' style='display:inline-block;margin-bottom:16px;color:#1890ff;text-decoration:none'>&larr; 返回售后列表</a>" +
            "<div style='background:#fff;border-radius:8px;padding:20px;margin-bottom:16px'>" +
            "<div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:16px'>" +
            "<h2 style='margin:0;font-size:20px'>售后详情</h2>" +
            "<span style='background:" + statusColor + "15;color:" + statusColor + ";padding:6px 16px;border-radius:4px;font-size:14px;font-weight:bold'>" + statusText + "</span>" +
            "</div>" +
            "<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;font-size:14px'>" +
            "<div><span style='color:#999'>售后单号：</span>" + convert.toString(a.id) + "</div>" +
            "<div><span style='color:#999'>订单号：</span>" + a.order_no + "</div>" +
            "<div><span style='color:#999'>退款金额：</span><span style='color:#ff4400;font-weight:bold'>¥" + convert.toString(a.refund_amount) + "</span></div>" +
            "<div><span style='color:#999'>申请时间：</span>" + a.created_at + "</div>" +
            "</div>" +
            "<div style='margin-top:16px;padding-top:16px;border-top:1px solid #f0f0f0'>" +
            "<div style='color:#999;font-size:14px;margin-bottom:8px'>售后原因：</div>" +
            "<div style='font-size:14px;color:#333;line-height:1.6'>" + a.reason + "</div>" +
            "</div>" +
            "</div>" +
            "<div style='background:#fff;border-radius:8px;padding:20px'>" +
            "<h3 style='margin:0 0 12px 0;font-size:16px'>订单商品</h3>" +
            itemsHtml +
            "<div style='display:flex;justify-content:space-between;padding-top:12px;margin-top:8px;border-top:2px solid #f0f0f0;font-weight:bold'>" +
            "<span>订单总额</span>" +
            "<span style='color:#ff4400'>¥" + convert.toString(a.total_amount) + "</span>" +
            "</div>" +
            "</div>" +
            "</div>"

        return res_html("<html><head><meta charset='utf-8'><title>售后详情</title></head><body style='margin:0;background:#f5f5f5;font-family:sans-serif'>" + body + "</body></html>")
    })
}

// TLL Mall - Logistics Tracking Page (all functions inlined)

from "./database" import db_exec, db_query, db_queryOne
from "./router" import router_get, res_html, res_redirect, req_getQuery
from "./auth" import auth_currentUser, cookie_getSessionId

fn logistics_checkAuth(req) {
    let sessionId = cookie_getSessionId(req)
    let user = auth_currentUser(sessionId)
    if (user == null) {
        return res_redirect("/login?redirect=/logistics")
    }
    req.currentUser = user
    return null
}

fn logistics_getShippedOrders(db, userId, page, pageSize) {
    let p = 1
    if (page != null) { p = page }
    let ps = 10
    if (pageSize != null) { ps = pageSize }
    let offset = (p - 1) * ps
    let offsetStr = convert.toString(offset)
    let psStr = convert.toString(ps)
    let sql = "SELECT * FROM orders WHERE user_id = ? AND shipping_status != 'unshipped' ORDER BY shipped_at DESC LIMIT " + psStr + " OFFSET " + offsetStr
    return db_query(db, sql, [userId])
}

fn logistics_getShippedTotal(db, userId) {
    let result = db_queryOne(db, "SELECT COUNT(*) as cnt FROM orders WHERE user_id = ? AND shipping_status != 'unshipped'", [userId])
    return result.cnt
}

fn logistics_getOrderItems(db, orderId) {
    return db_query(db, "SELECT oi.*, p.name as product_name, p.image as product_image FROM order_items oi LEFT JOIN products p ON oi.product_id = p.id WHERE oi.order_id = ?", [orderId])
}

fn logistics_statusText(status) {
    if (status == "shipped") { return "已发货" }
    if (status == "delivered") { return "已送达" }
    if (status == "completed") { return "已完成" }
    return status
}

fn logistics_statusBadge(status) {
    if (status == "shipped") { return "<span style='background:#e6f7ff;color:#1890ff;padding:4px 12px;border-radius:4px;font-size:13px'>已发货</span>" }
    if (status == "delivered") { return "<span style='background:#f6ffed;color:#52c41a;padding:4px 12px;border-radius:4px;font-size:13px'>已送达</span>" }
    if (status == "completed") { return "<span style='background:#f0f0f0;color:#666;padding:4px 12px;border-radius:4px;font-size:13px'>已完成</span>" }
    return "<span style='background:#fff7e6;color:#fa8c16;padding:4px 12px;border-radius:4px;font-size:13px'>" + status + "</span>"
}

fn logistics_timeline(order) {
    let html = "<div style='position:relative;padding-left:24px'>"
    html = html + "<div style='position:absolute;left:8px;top:8px;width:2px;height:100%;background:#e8e8e8'></div>"

    html = html + "<div style='position:relative;margin-bottom:20px'>"
    html = html + "<div style='position:absolute;left:-20px;top:4px;width:12px;height:12px;border-radius:50%;background:#1890ff;border:2px solid #fff;box-shadow:0 0 0 2px #1890ff'></div>"
    html = html + "<div style='font-weight:bold;color:#333;margin-bottom:4px'>订单已创建</div>"
    html = html + "<div style='font-size:12px;color:#999'>" + order.created_at + "</div>"
    html = html + "</div>"

    if (order.paid_at != null) {
        html = html + "<div style='position:relative;margin-bottom:20px'>"
        html = html + "<div style='position:absolute;left:-20px;top:4px;width:12px;height:12px;border-radius:50%;background:#52c41a;border:2px solid #fff;box-shadow:0 0 0 2px #52c41a'></div>"
        html = html + "<div style='font-weight:bold;color:#333;margin-bottom:4px'>支付成功</div>"
        html = html + "<div style='font-size:12px;color:#999'>" + order.paid_at + "</div>"
        html = html + "</div>"
    }

    if (order.shipped_at != null) {
        html = html + "<div style='position:relative;margin-bottom:20px'>"
        html = html + "<div style='position:absolute;left:-20px;top:4px;width:12px;height:12px;border-radius:50%;background:#fa8c16;border:2px solid #fff;box-shadow:0 0 0 2px #fa8c16'></div>"
        html = html + "<div style='font-weight:bold;color:#333;margin-bottom:4px'>商品已发出</div>"
        html = html + "<div style='font-size:12px;color:#999'>" + order.shipped_at + "</div>"
        html = html + "<div style='font-size:13px;color:#666;margin-top:4px'>包裹正在运输中，请耐心等待</div>"
        html = html + "</div>"
    }

    if (order.completed_at != null) {
        html = html + "<div style='position:relative;margin-bottom:20px'>"
        html = html + "<div style='position:absolute;left:-20px;top:4px;width:12px;height:12px;border-radius:50%;background:#52c41a;border:2px solid #fff;box-shadow:0 0 0 2px #52c41a'></div>"
        html = html + "<div style='font-weight:bold;color:#333;margin-bottom:4px'>订单已完成</div>"
        html = html + "<div style='font-size:12px;color:#999'>" + order.completed_at + "</div>"
        html = html + "</div>"
    }

    html = html + "</div>"
    return html
}

fn logistics_page(title, body) {
    return "<!DOCTYPE html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>" + title + " - TLL OS 商城</title><style>" +
        "body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;margin:0;background:#f5f5f5;color:#333}" +
        ".header{background:#fff;padding:16px 24px;box-shadow:0 2px 8px rgba(0,0,0,0.08);display:flex;justify-content:space-between;align-items:center}" +
        ".header h1{margin:0;font-size:20px;color:#1890ff}" +
        ".header a{color:#666;text-decoration:none;margin-left:16px}" +
        ".container{max-width:900px;margin:24px auto;padding:0 16px}" +
        ".order-card{background:#fff;border-radius:8px;margin-bottom:16px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.06)}" +
        ".order-header{padding:16px 24px;background:#fafafa;border-bottom:1px solid #f0f0f0;display:flex;justify-content:space-between;align-items:center}" +
        ".order-no{font-size:14px;color:#666}" +
        ".order-no strong{color:#333}" +
        ".order-body{padding:24px}" +
        ".order-items{margin-bottom:20px}" +
        ".order-item{display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid #f5f5f5}" +
        ".order-item:last-child{border-bottom:none}" +
        ".item-image{width:60px;height:60px;background:#f0f0f0;border-radius:4px;display:flex;align-items:center;justify-content:center;color:#999;font-size:12px;flex-shrink:0}" +
        ".item-info{flex:1}" +
        ".item-name{font-size:14px;color:#333;margin-bottom:4px}" +
        ".item-price{font-size:13px;color:#ff4d4f}" +
        ".item-quantity{font-size:12px;color:#999}" +
        ".timeline-section{background:#fafafa;padding:20px;border-radius:8px}" +
        ".timeline-title{font-size:15px;font-weight:bold;margin-bottom:16px;color:#333}" +
        ".order-amount{text-align:right;padding:16px 24px;background:#fafafa;border-top:1px solid #f0f0f0}" +
        ".order-amount .total{font-size:18px;color:#ff4d4f;font-weight:bold}" +
        ".empty{text-align:center;padding:80px 24px;color:#999;background:#fff;border-radius:8px}" +
        ".empty .icon{font-size:64px;margin-bottom:16px}" +
        ".empty a{display:inline-block;margin-top:16px;padding:10px 24px;background:#1890ff;color:#fff;text-decoration:none;border-radius:4px}" +
        ".pagination{text-align:center;padding:16px;background:#fff;border-radius:8px;margin-top:16px}" +
        ".pagination a{display:inline-block;padding:6px 12px;margin:0 4px;border:1px solid #d9d9d9;border-radius:4px;color:#666;text-decoration:none;font-size:13px}" +
        ".pagination a.active{background:#1890ff;color:#fff;border-color:#1890ff}" +
        ".pagination a.disabled{color:#ccc;cursor:not-allowed}" +
        "</style></head><body>" + body + "</body></html>"
}

fn logistics_registerRoutes(router) {
    router_get(router, "/logistics", fn(req) {
        let authResult = logistics_checkAuth(req)
        if (authResult != null) { return authResult }

        let userId = req.currentUser.id
        let page = 1
        let pageStr = req_getQuery(req, "page", "1")
        page = convert.toInt(pageStr)
        if (page < 1) { page = 1 }
        let pageSize = 10

        let orders = logistics_getShippedOrders(req.db, userId, page, pageSize)
        let total = logistics_getShippedTotal(req.db, userId)
        let totalPages = (total + pageSize - 1) / pageSize
        if (totalPages < 1) { totalPages = 1 }

        let listHtml = ""
        let i = 0
        while (i < arrays.length(orders)) {
            let order = orders[i]
            let items = logistics_getOrderItems(req.db, order.id)

            let itemsHtml = ""
            let j = 0
            while (j < arrays.length(items)) {
                let item = items[j]
                let productName = "商品"
                if (item.product_name != null) { productName = item.product_name }
                itemsHtml = itemsHtml +
                    "<div class='order-item'>" +
                    "<div class='item-image'>📦</div>" +
                    "<div class='item-info'>" +
                    "<div class='item-name'>" + productName + "</div>" +
                    "<div class='item-price'>¥" + convert.toString(item.price) + " <span class='item-quantity'>x" + convert.toString(item.quantity) + "</span></div>" +
                    "</div></div>"
                j = j + 1
            }

            listHtml = listHtml +
                "<div class='order-card'>" +
                "<div class='order-header'>" +
                "<div class='order-no'>订单号：<strong>" + order.order_no + "</strong></div>" +
                logistics_statusBadge(order.shipping_status) +
                "</div>" +
                "<div class='order-body'>" +
                "<div class='order-items'>" + itemsHtml + "</div>" +
                "<div class='timeline-section'>" +
                "<div class='timeline-title'>📦 物流跟踪</div>" +
                logistics_timeline(order) +
                "</div>" +
                "</div>" +
                "<div class='order-amount'>" +
                "订单金额：<span class='total'>¥" + convert.toString(order.total_amount) + "</span>" +
                "</div>" +
                "</div>"
            i = i + 1
        }

        if (arrays.length(orders) == 0) {
            listHtml = "<div class='empty'><div class='icon'>🚚</div><div>暂无已发货订单</div><a href='/orders'>查看全部订单</a></div>"
        }

        let paginationHtml = "<div class='pagination'>"
        if (page > 1) {
            paginationHtml = paginationHtml + "<a href='/logistics?page=" + convert.toString(page - 1) + "'>上一页</a>"
        } else {
            paginationHtml = paginationHtml + "<a class='disabled'>上一页</a>"
        }
        let pi = 1
        while (pi <= totalPages) {
            let activeClass = ""
            if (pi == page) { activeClass = " active" }
            paginationHtml = paginationHtml + "<a href='/logistics?page=" + convert.toString(pi) + "' class='" + activeClass + "'>" + convert.toString(pi) + "</a>"
            pi = pi + 1
        }
        if (page < totalPages) {
            paginationHtml = paginationHtml + "<a href='/logistics?page=" + convert.toString(page + 1) + "'>下一页</a>"
        } else {
            paginationHtml = paginationHtml + "<a class='disabled'>下一页</a>"
        }
        paginationHtml = paginationHtml + "</div>"

        let body =
            "<div class='header'><h1>🚚 物流跟踪</h1><div><a href='/'>首页</a><a href='/orders'>我的订单</a><a href='/user'>个人中心</a></div></div>" +
            "<div class='container'>" +
            listHtml +
            paginationHtml +
            "</div>"

        return res_html(logistics_page("物流跟踪", body))
    })
}

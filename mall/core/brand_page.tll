// TLL Mall - Brand Zone Page
// All logic inline to ensure stability

from "./database" import db_query, db_queryOne
from "./router" import router_get, res_html, res_redirect, req_getQuery
from "./auth" import auth_currentUser, cookie_getSessionId

fn brand_registerRoutes(router) {
    // Brand list (品牌列表)
    router_get(router, "/brands", fn(req) {
        let brands = db_query(req.db, "SELECT * FROM brands WHERE status = 1 ORDER BY sort_order ASC, id DESC LIMIT 50", [])

        let listHtml = ""
        let i = 0
        while (i < arrays.length(brands)) {
            let b = brands[i]
            let logoHtml = ""
            if (b.logo != null && b.logo != "") {
                logoHtml = "<img src='" + b.logo + "' style='width:80px;height:80px;object-fit:contain;border-radius:8px' alt='" + b.name + "'>"
            }
            if (b.logo == null || b.logo == "") {
                logoHtml = "<div style='width:80px;height:80px;background:linear-gradient(135deg,#667eea,#764ba2);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:28px;font-weight:bold'>" + b.name[0] + "</div>"
            }

            listHtml = listHtml +
                "<a href='/brand/" + convert.toString(b.id) + "' style='display:block;background:#fff;border-radius:8px;padding:16px;margin-bottom:12px;text-decoration:none;color:inherit;display:flex;align-items:center;gap:16px'>" +
                logoHtml +
                "<div style='flex:1'>" +
                "<div style='font-size:18px;font-weight:bold;margin-bottom:4px'>" + b.name + "</div>" +
                "<div style='font-size:13px;color:#666;line-height:1.5'>" + b.description + "</div>" +
                "</div>" +
                "<div style='color:#999;font-size:14px'>&rarr;</div>" +
                "</a>"
            i = i + 1
        }

        if (arrays.length(brands) == 0) {
            listHtml = "<div style='padding:60px;text-align:center;color:#999;background:#fff;border-radius:8px'>暂无品牌</div>"
        }

        let body =
            "<div style='background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;padding:20px;margin-bottom:16px'>" +
            "<div style='max-width:800px;margin:0 auto'>" +
            "<h1 style='margin:0 0 4px 0;font-size:28px'>🏷️ 品牌专区</h1>" +
            "<p style='margin:0;font-size:14px;opacity:0.9'>精选优质品牌，品质保障</p>" +
            "</div>" +
            "</div>" +
            "<div style='max-width:800px;margin:0 auto;padding:0 16px'>" +
            listHtml +
            "</div>"

        return res_html("<html><head><meta charset='utf-8'><title>品牌专区</title></head><body style='margin:0;background:#f5f5f5;font-family:sans-serif'>" + body + "</body></html>")
    })

    // Brand detail (品牌详情)
    router_get(router, "/brand/:id", fn(req) {
        let brandId = convert.toInt(req.params.id)
        let page = convert.toInt(req_getQuery(req, "page", "1"))
        if (page < 1) { page = 1 }
        let pageSize = 12
        let offset = (page - 1) * pageSize

        let brand = db_queryOne(req.db, "SELECT * FROM brands WHERE id = ? AND status = 1", [brandId])
        if (brand == null) {
            return res_redirect("/brands")
        }

        let products = db_query(req.db, "SELECT * FROM products WHERE brand_id = ? AND status = 1 ORDER BY sort_order ASC, id DESC LIMIT ? OFFSET ?", [brandId, pageSize, offset])
        let totalResult = db_queryOne(req.db, "SELECT COUNT(*) as total FROM products WHERE brand_id = ? AND status = 1", [brandId])
        let total = totalResult.total
        let totalPages = total / pageSize
        if (total % pageSize != 0) { totalPages = totalPages + 1 }

        let logoHtml = ""
        if (brand.logo != null && brand.logo != "") {
            logoHtml = "<img src='" + brand.logo + "' style='width:100px;height:100px;object-fit:contain;border-radius:12px;background:#fff;padding:8px' alt='" + brand.name + "'>"
        }
        if (brand.logo == null || brand.logo == "") {
            logoHtml = "<div style='width:100px;height:100px;background:linear-gradient(135deg,#667eea,#764ba2);border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:36px;font-weight:bold'>" + brand.name[0] + "</div>"
        }

        let productsHtml = ""
        let i = 0
        while (i < arrays.length(products)) {
            let p = products[i]
            let imageHtml = ""
            if (p.image != null && p.image != "") {
                imageHtml = "<img src='" + p.image + "' style='width:100%;height:180px;object-fit:cover;border-radius:8px 8px 0 0' alt='" + p.name + "'>"
            }
            if (p.image == null || p.image == "") {
                imageHtml = "<div style='width:100%;height:180px;background:linear-gradient(135deg,#f5f7fa,#c3cfe2);border-radius:8px 8px 0 0;display:flex;align-items:center;justify-content:center;color:#999;font-size:48px'>📦</div>"
            }

            productsHtml = productsHtml +
                "<a href='/product/" + convert.toString(p.id) + "' style='display:block;background:#fff;border-radius:8px;overflow:hidden;text-decoration:none;color:inherit;box-shadow:0 2px 8px rgba(0,0,0,0.06)'>" +
                imageHtml +
                "<div style='padding:12px'>" +
                "<div style='font-size:14px;font-weight:bold;margin-bottom:6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap'>" + p.name + "</div>" +
                "<div style='display:flex;justify-content:space-between;align-items:center'>" +
                "<span style='color:#ff4400;font-size:18px;font-weight:bold'>¥" + convert.toString(p.price) + "</span>" +
                "<span style='color:#999;font-size:12px'>销量" + convert.toString(p.sales) + "</span>" +
                "</div>" +
                "</div>" +
                "</a>"
            i = i + 1
        }

        if (arrays.length(products) == 0) {
            productsHtml = "<div style='padding:60px;text-align:center;color:#999;background:#fff;border-radius:8px;grid-column:1/-1'>该品牌暂无商品</div>"
        }

        let paginationHtml = ""
        if (totalPages > 1) {
            paginationHtml = "<div style='display:flex;justify-content:center;gap:8px;margin-top:24px'>"
            if (page > 1) {
                paginationHtml = paginationHtml + "<a href='/brand/" + convert.toString(brandId) + "?page=" + convert.toString(page - 1) + "' style='padding:8px 16px;background:#fff;border:1px solid #ddd;border-radius:4px;text-decoration:none;color:#333'>上一页</a>"
            }
            paginationHtml = paginationHtml + "<span style='padding:8px 16px;background:#667eea;color:#fff;border-radius:4px'>" + convert.toString(page) + " / " + convert.toString(totalPages) + "</span>"
            if (page < totalPages) {
                paginationHtml = paginationHtml + "<a href='/brand/" + convert.toString(brandId) + "?page=" + convert.toString(page + 1) + "' style='padding:8px 16px;background:#fff;border:1px solid #ddd;border-radius:4px;text-decoration:none;color:#333'>下一页</a>"
            }
            paginationHtml = paginationHtml + "</div>"
        }

        let body =
            "<div style='background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;padding:24px;margin-bottom:16px'>" +
            "<div style='max-width:800px;margin:0 auto'>" +
            "<a href='/brands' style='color:#fff;opacity:0.9;text-decoration:none;font-size:14px'>&larr; 返回品牌列表</a>" +
            "<div style='display:flex;align-items:center;gap:20px;margin-top:16px'>" +
            logoHtml +
            "<div>" +
            "<h1 style='margin:0 0 8px 0;font-size:32px'>" + brand.name + "</h1>" +
            "<p style='margin:0;font-size:14px;opacity:0.9;line-height:1.6'>" + brand.description + "</p>" +
            "</div>" +
            "</div>" +
            "</div>" +
            "</div>" +
            "<div style='max-width:800px;margin:0 auto;padding:0 16px'>" +
            "<div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:16px'>" +
            "<h2 style='margin:0;font-size:20px'>品牌商品</h2>" +
            "<span style='color:#999;font-size:14px'>共" + convert.toString(total) + "件商品</span>" +
            "</div>" +
            "<div style='display:grid;grid-template-columns:repeat(3,1fr);gap:16px'>" +
            productsHtml +
            "</div>" +
            paginationHtml +
            "</div>"

        return res_html("<html><head><meta charset='utf-8'><title>" + brand.name + " - 品牌专区</title></head><body style='margin:0;background:#f5f5f5;font-family:sans-serif'>" + body + "</body></html>")
    })
}

// TLL Mall - Notification Page (step by step)

from "./database" import db_query, db_queryOne
from "./router" import router_get, res_html, res_redirect
from "./auth" import auth_currentUser, cookie_getSessionId

fn notification_checkAuth(req) {
    let sessionId = cookie_getSessionId(req)
    let user = auth_currentUser(sessionId)
    if (user == null) {
        return res_redirect("/login")
    }
    req.currentUser = user
    return null
}

fn notification_getList(db, userId, page, pageSize) {
    let p = 1
    if (page != null) { p = page }
    let ps = 20
    if (pageSize != null) { ps = pageSize }
    let offset = (p - 1) * ps
    let offsetStr = convert.toString(offset)
    let psStr = convert.toString(ps)
    let sql = "SELECT * FROM notifications WHERE user_id = ? ORDER BY id DESC LIMIT " + psStr + " OFFSET " + offsetStr
    return db_query(db, sql, [userId])
}

fn notification_registerRoutes(router) {
    router_get(router, "/notifications", fn(req) {
        let authResult = notification_checkAuth(req)
        if (authResult != null) { return authResult }
        let notifications = notification_getList(req.db, req.currentUser.id, 1, 20)
        let count = arrays.length(notifications)
        return res_html("<html><body><h1>Notifications</h1><p>Count: " + convert.toString(count) + "</p></body></html>")
    })
}

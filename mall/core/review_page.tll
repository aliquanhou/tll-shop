// TLL Mall - Product Review Page (all functions inlined)

from "./database" import db_exec, db_query, db_queryOne
from "./router" import router_get, router_post, res_html, res_redirect, req_getQuery, req_getJsonBody
from "./auth" import auth_currentUser, cookie_getSessionId

fn review_checkAuth(req) {
    let sessionId = cookie_getSessionId(req)
    let user = auth_currentUser(sessionId)
    if (user == null) {
        return res_redirect("/login?redirect=/reviews")
    }
    req.currentUser = user
    return null
}

fn review_add(db, userId, productId, orderId, rating, content) {
    let r = 5
    if (rating != null) { r = rating }
    let c = ""
    if (content != null) { c = content }
    let oid = null
    if (orderId != null) { oid = orderId }
    db_exec(db, "INSERT INTO reviews (product_id, user_id, order_id, rating, content, status) VALUES (?, ?, ?, ?, ?, 'approved')", [productId, userId, oid, r, c])
    return true
}

fn review_getByProduct(db, productId, page, pageSize) {
    let p = 1
    if (page != null) { p = page }
    let ps = 10
    if (pageSize != null) { ps = pageSize }
    let offset = (p - 1) * ps
    let offsetStr = convert.toString(offset)
    let psStr = convert.toString(ps)
    let sql = "SELECT r.*, u.username as user_name FROM reviews r LEFT JOIN users u ON r.user_id = u.id WHERE r.product_id = ? AND r.status = 'approved' ORDER BY r.id DESC LIMIT " + psStr + " OFFSET " + offsetStr
    return db_query(db, sql, [productId])
}

fn review_getTotalByProduct(db, productId) {
    let result = db_queryOne(db, "SELECT COUNT(*) as cnt FROM reviews WHERE product_id = ? AND status = 'approved'", [productId])
    return result.cnt
}

fn review_getAverageRating(db, productId) {
    let result = db_queryOne(db, "SELECT AVG(rating) as avg_rating FROM reviews WHERE product_id = ? AND status = 'approved'", [productId])
    if (result.avg_rating == null) { return 0 }
    return result.avg_rating
}

fn review_getByUser(db, userId, page, pageSize) {
    let p = 1
    if (page != null) { p = page }
    let ps = 10
    if (pageSize != null) { ps = pageSize }
    let offset = (p - 1) * ps
    let offsetStr = convert.toString(offset)
    let psStr = convert.toString(ps)
    let sql = "SELECT r.*, p.name as product_name, p.image as product_image FROM reviews r LEFT JOIN products p ON r.product_id = p.id WHERE r.user_id = ? ORDER BY r.id DESC LIMIT " + psStr + " OFFSET " + offsetStr
    return db_query(db, sql, [userId])
}

fn review_getTotalByUser(db, userId) {
    let result = db_queryOne(db, "SELECT COUNT(*) as cnt FROM reviews WHERE user_id = ?", [userId])
    return result.cnt
}

fn review_ratingStars(rating) {
    let stars = ""
    let i = 1
    while (i <= 5) {
        if (i <= rating) {
            stars = stars + "⭐"
        } else {
            stars = stars + "☆"
        }
        i = i + 1
    }
    return stars
}

fn review_page(title, body) {
    return "<!DOCTYPE html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>" + title + " - TLL OS 商城</title><style>" +
        "body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;margin:0;background:#f5f5f5;color:#333}" +
        ".header{background:#fff;padding:16px 24px;box-shadow:0 2px 8px rgba(0,0,0,0.08);display:flex;justify-content:space-between;align-items:center}" +
        ".header h1{margin:0;font-size:20px;color:#1890ff}" +
        ".header a{color:#666;text-decoration:none;margin-left:16px}" +
        ".container{max-width:900px;margin:24px auto;padding:0 16px}" +
        ".review-summary{background:#fff;padding:24px;border-radius:8px;margin-bottom:16px;display:flex;align-items:center;gap:24px}" +
        ".review-summary .avg-rating{font-size:48px;color:#ff4d4f;font-weight:bold}" +
        ".review-summary .stars{font-size:24px}" +
        ".review-summary .count{color:#999;font-size:14px}" +
        ".review-form{background:#fff;padding:24px;border-radius:8px;margin-bottom:16px}" +
        ".review-form h3{margin:0 0 16px 0;font-size:16px}" +
        ".form-group{margin-bottom:16px}" +
        ".form-group label{display:block;margin-bottom:8px;font-size:14px;color:#666}" +
        ".form-group select,.form-group textarea{width:100%;padding:8px 12px;border:1px solid #d9d9d9;border-radius:4px;font-size:14px;box-sizing:border-box}" +
        ".form-group textarea{min-height:100px;resize:vertical}" +
        ".btn{display:inline-block;padding:10px 24px;background:#1890ff;color:#fff;text-decoration:none;border-radius:4px;border:none;cursor:pointer;font-size:14px}" +
        ".review-list{background:#fff;border-radius:8px;overflow:hidden}" +
        ".review-item{padding:20px 24px;border-bottom:1px solid #f0f0f0}" +
        ".review-item:last-child{border-bottom:none}" +
        ".review-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}" +
        ".review-user{font-weight:bold;color:#333}" +
        ".review-rating{font-size:16px}" +
        ".review-content{color:#666;font-size:14px;line-height:1.6;margin-bottom:8px}" +
        ".review-date{color:#999;font-size:12px}" +
        ".review-product{display:flex;align-items:center;gap:12px;margin-bottom:12px;padding:12px;background:#f9f9f9;border-radius:4px}" +
        ".review-product .product-name{font-size:14px;color:#333}" +
        ".empty{text-align:center;padding:60px 24px;color:#999;background:#fff;border-radius:8px}" +
        ".empty .icon{font-size:48px;margin-bottom:16px}" +
        ".pagination{text-align:center;padding:16px;background:#fff;border-radius:8px;margin-top:16px}" +
        ".pagination a{display:inline-block;padding:6px 12px;margin:0 4px;border:1px solid #d9d9d9;border-radius:4px;color:#666;text-decoration:none;font-size:13px}" +
        ".pagination a.active{background:#1890ff;color:#fff;border-color:#1890ff}" +
        ".pagination a.disabled{color:#ccc;cursor:not-allowed}" +
        "</style></head><body>" + body + "</body></html>"
}

fn review_registerRoutes(router) {
    router_get(router, "/reviews", fn(req) {
        let authResult = review_checkAuth(req)
        if (authResult != null) { return authResult }

        let userId = req.currentUser.id
        let page = 1
        let pageStr = req_getQuery(req, "page", "1")
        page = convert.toInt(pageStr)
        if (page < 1) { page = 1 }
        let pageSize = 10

        let reviews = review_getByUser(req.db, userId, page, pageSize)
        let total = review_getTotalByUser(req.db, userId)
        let totalPages = (total + pageSize - 1) / pageSize
        if (totalPages < 1) { totalPages = 1 }

        let listHtml = ""
        let i = 0
        while (i < arrays.length(reviews)) {
            let r = reviews[i]
            let productName = "商品已下架"
            if (r.product_name != null) { productName = r.product_name }
            listHtml = listHtml +
                "<div class='review-item'>" +
                "<div class='review-product'>" +
                "<div class='product-name'>" + productName + "</div>" +
                "</div>" +
                "<div class='review-header'>" +
                "<div class='review-user'>我的评价</div>" +
                "<div class='review-rating'>" + review_ratingStars(r.rating) + "</div>" +
                "</div>" +
                "<div class='review-content'>" + r.content + "</div>" +
                "<div class='review-date'>" + r.created_at + "</div>" +
                "</div>"
            i = i + 1
        }

        if (arrays.length(reviews) == 0) {
            listHtml = "<div class='empty'><div class='icon'>📝</div><div>还没有评价</div></div>"
        }

        let paginationHtml = "<div class='pagination'>"
        if (page > 1) {
            paginationHtml = paginationHtml + "<a href='/reviews?page=" + convert.toString(page - 1) + "'>上一页</a>"
        } else {
            paginationHtml = paginationHtml + "<a class='disabled'>上一页</a>"
        }
        let pi = 1
        while (pi <= totalPages) {
            let activeClass = ""
            if (pi == page) { activeClass = " active" }
            paginationHtml = paginationHtml + "<a href='/reviews?page=" + convert.toString(pi) + "' class='" + activeClass + "'>" + convert.toString(pi) + "</a>"
            pi = pi + 1
        }
        if (page < totalPages) {
            paginationHtml = paginationHtml + "<a href='/reviews?page=" + convert.toString(page + 1) + "'>下一页</a>"
        } else {
            paginationHtml = paginationHtml + "<a class='disabled'>下一页</a>"
        }
        paginationHtml = paginationHtml + "</div>"

        let body =
            "<div class='header'><h1>📝 我的评价</h1><div><a href='/'>首页</a><a href='/user'>个人中心</a></div></div>" +
            "<div class='container'>" +
            "<div class='review-list'>" + listHtml + "</div>" +
            paginationHtml +
            "</div>"

        return res_html(review_page("我的评价", body))
    })

    router_get(router, "/product/:id/reviews", fn(req) {
        let productId = convert.toInt(req.params.id)
        let page = 1
        let pageStr = req_getQuery(req, "page", "1")
        page = convert.toInt(pageStr)
        if (page < 1) { page = 1 }
        let pageSize = 10

        let reviews = review_getByProduct(req.db, productId, page, pageSize)
        let total = review_getTotalByProduct(req.db, productId)
        let avgRating = review_getAverageRating(req.db, productId)
        let totalPages = (total + pageSize - 1) / pageSize
        if (totalPages < 1) { totalPages = 1 }

        let listHtml = ""
        let i = 0
        while (i < arrays.length(reviews)) {
            let r = reviews[i]
            let userName = "匿名用户"
            if (r.user_name != null) { userName = r.user_name }
            listHtml = listHtml +
                "<div class='review-item'>" +
                "<div class='review-header'>" +
                "<div class='review-user'>" + userName + "</div>" +
                "<div class='review-rating'>" + review_ratingStars(r.rating) + "</div>" +
                "</div>" +
                "<div class='review-content'>" + r.content + "</div>" +
                "<div class='review-date'>" + r.created_at + "</div>" +
                "</div>"
            i = i + 1
        }

        if (arrays.length(reviews) == 0) {
            listHtml = "<div class='empty'><div class='icon'>📝</div><div>暂无评价</div></div>"
        }

        let paginationHtml = "<div class='pagination'>"
        if (page > 1) {
            paginationHtml = paginationHtml + "<a href='/product/" + convert.toString(productId) + "/reviews?page=" + convert.toString(page - 1) + "'>上一页</a>"
        } else {
            paginationHtml = paginationHtml + "<a class='disabled'>上一页</a>"
        }
        let pi = 1
        while (pi <= totalPages) {
            let activeClass = ""
            if (pi == page) { activeClass = " active" }
            paginationHtml = paginationHtml + "<a href='/product/" + convert.toString(productId) + "/reviews?page=" + convert.toString(pi) + "' class='" + activeClass + "'>" + convert.toString(pi) + "</a>"
            pi = pi + 1
        }
        if (page < totalPages) {
            paginationHtml = paginationHtml + "<a href='/product/" + convert.toString(productId) + "/reviews?page=" + convert.toString(page + 1) + "'>下一页</a>"
        } else {
            paginationHtml = paginationHtml + "<a class='disabled'>下一页</a>"
        }
        paginationHtml = paginationHtml + "</div>"

        let body =
            "<div class='header'><h1>📝 商品评价</h1><div><a href='/product/" + convert.toString(productId) + "'>返回商品</a></div></div>" +
            "<div class='container'>" +
            "<div class='review-summary'>" +
            "<div class='avg-rating'>" + convert.toString(avgRating) + "</div>" +
            "<div><div class='stars'>" + review_ratingStars(convert.toInt(convert.toString(avgRating))) + "</div><div class='count'>共 " + convert.toString(total) + " 条评价</div></div>" +
            "</div>" +
            "<div class='review-list'>" + listHtml + "</div>" +
            paginationHtml +
            "</div>"

        return res_html(review_page("商品评价", body))
    })
}

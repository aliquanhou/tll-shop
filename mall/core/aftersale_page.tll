// TLL Mall - After Sales Page - Version 3 (list + detail + order items)

from "./database" import db_query, db_queryOne
from "./router" import router_get, res_html, res_redirect, req_getQuery
from "./auth" import auth_currentUser, cookie_getSessionId

fn aftersale_checkAuth(req) {
    let sessionId = cookie_getSessionId(req)
    let user = auth_currentUser(sessionId)
    if (user == null) {
        return res_redirect("/login")
    }
    req.currentUser = user
    return null
}

fn aftersale_getByUser(db, userId) {
    return db_query(db, "SELECT a.*, o.order_no FROM after_sales a LEFT JOIN orders o ON a.order_id = o.id WHERE a.user_id = ? ORDER BY a.id DESC LIMIT 20", [userId])
}

fn aftersale_getById(db, id, userId) {
    return db_queryOne(db, "SELECT a.*, o.order_no, o.total_amount, o.address_name, o.address_phone, o.address_detail FROM after_sales a LEFT JOIN orders o ON a.order_id = o.id WHERE a.id = ? AND a.user_id = ?", [id, userId])
}

fn aftersale_getOrderItems(db, orderId) {
    return db_query(db, "SELECT oi.*, p.name as product_name FROM order_items oi LEFT JOIN products p ON oi.product_id = p.id WHERE oi.order_id = ?", [orderId])
}

fn aftersale_registerRoutes(router) {
    router_get(router, "/aftersales", fn(req) {
        let authResult = aftersale_checkAuth(req)
        if (authResult != null) { return authResult }

        let userId = req.currentUser.id
        let aftersales = aftersale_getByUser(req.db, userId)

        let listHtml = ""
        let i = 0
        while (i < arrays.length(aftersales)) {
            let a = aftersales[i]
            listHtml = listHtml +
                "<a href='/aftersale/" + convert.toString(a.id) + "' style='text-decoration:none;color:inherit;display:block;padding:16px;background:#fff;margin-bottom:8px;border-radius:4px'>" +
                "<div>订单号：" + a.order_no + "</div>" +
                "<div>原因：" + a.reason + "</div>" +
                "<div>金额：" + convert.toString(a.amount) + "</div>" +
                "<div>状态：" + a.status + "</div>" +
                "<div>时间：" + a.created_at + "</div>" +
                "</a>"
            i = i + 1
        }

        if (arrays.length(aftersales) == 0) {
            listHtml = "<div style='padding:40px;text-align:center;color:#999;background:#fff'>暂无售后记录</div>"
        }

        let body =
            "<div style='padding:16px;background:#fff;margin-bottom:16px'><h1 style='margin:0;font-size:18px'>售后管理</h1></div>" +
            "<div style='max-width:800px;margin:0 auto'>" + listHtml + "</div>"

        return res_html("<html><head><meta charset='utf-8'><title>售后管理</title></head><body style='margin:0;background:#f5f5f5;font-family:sans-serif'>" + body + "</body></html>")
    })

    router_get(router, "/aftersale/:id", fn(req) {
        let authResult = aftersale_checkAuth(req)
        if (authResult != null) { return authResult }

        let id = convert.toInt(req.params.id)
        let aftersale = aftersale_getById(req.db, id, req.currentUser.id)
        if (aftersale == null) {
            return res_redirect("/aftersales")
        }

        let items = aftersale_getOrderItems(req.db, aftersale.order_id)
        let itemsHtml = ""
        let j = 0
        while (j < arrays.length(items)) {
            let item = items[j]
            let productName = "商品"
            if (item.product_name != null) { productName = item.product_name }
            itemsHtml = itemsHtml +
                "<div style='padding:8px 0;border-bottom:1px solid #f0f0f0;display:flex;justify-content:space-between'>" +
                "<span>" + productName + "</span>" +
                "<span>¥" + convert.toString(item.price) + " x" + convert.toString(item.quantity) + "</span>" +
                "</div>"
            j = j + 1
        }

        let body =
            "<div style='padding:16px;background:#fff;margin-bottom:16px'><h1 style='margin:0;font-size:18px'>售后详情</h1></div>" +
            "<div style='max-width:800px;margin:0 auto;background:#fff;padding:24px;border-radius:4px'>" +
            "<div style='margin-bottom:12px'><strong>订单号：</strong>" + aftersale.order_no + "</div>" +
            "<div style='margin-bottom:12px'><strong>售后类型：</strong>" + aftersale.type + "</div>" +
            "<div style='margin-bottom:12px'><strong>售后原因：</strong>" + aftersale.reason + "</div>" +
            "<div style='margin-bottom:12px'><strong>退款金额：</strong>" + convert.toString(aftersale.amount) + "</div>" +
            "<div style='margin-bottom:12px'><strong>订单金额：</strong>" + convert.toString(aftersale.total_amount) + "</div>" +
            "<div style='margin-bottom:12px'><strong>状态：</strong>" + aftersale.status + "</div>" +
            "<div style='margin-bottom:12px'><strong>申请时间：</strong>" + aftersale.created_at + "</div>" +
            "<div style='margin-top:24px;margin-bottom:12px'><strong>订单商品：</strong></div>" +
            itemsHtml +
            "<div style='margin-top:24px'><a href='/aftersales' style='color:#1890ff;text-decoration:none'>返回列表</a></div>" +
            "</div>"

        return res_html("<html><head><meta charset='utf-8'><title>售后详情</title></head><body style='margin:0;background:#f5f5f5;font-family:sans-serif'>" + body + "</body></html>")
    })
}
